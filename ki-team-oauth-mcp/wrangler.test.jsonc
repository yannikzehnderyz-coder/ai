// NUR FÜR AUTOMATISIERTE TESTS (wrangler dev lokal). Wird nie bereitgestellt.
{
	"name": "ki-team-oauth-mcp-test",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,

	// v1 ist bereits durch die zuvor bereitgestellte Demo angewendet (MyMCP).
	// UsageLimiter MUSS daher eine eigene, neue Migration bekommen.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MyMCP"] },
		{ "tag": "v2", "new_sqlite_classes": ["UsageLimiter"] },
		{ "tag": "v3", "new_sqlite_classes": ["ProjectStore"] }
	],
	"durable_objects": {
		"bindings": [
			{ "class_name": "MyMCP", "name": "MCP_OBJECT" },
			{ "class_name": "UsageLimiter", "name": "USAGE_LIMITER" },
			{ "class_name": "ProjectStore", "name": "PROJECT_STORE" }
		]
	},

	// Vorhandener KV-Namespace "ki-team-oauth" (bereits angelegt, nicht duplizieren)
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "328dc2347f26431ab765fb47ddb5adbc"
		}
	],

	// Interne Verbindung zum bestehenden Hauptworker – kein öffentlicher HTTP-Aufruf
	"services": [
		{
			"binding": "KI_TEAM",
			"service": "claude-ki-team"
		}
	],

	// Nicht-geheime Konfiguration
	"vars": {
		// Nur dieser GitHub-Account (numerische, unveränderliche ID von "yannikzehnderyz-coder") darf sich anmelden
		"ALLOWED_GITHUB_USER_IDS": "340084289",
		// Nur Claude (claude.ai / Desktop / Mobile) darf Tokens empfangen
		"ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback",
		// Harte Obergrenze für KI-Aufrufe über MCP pro UTC-Tag (zusätzlich zum Limit im Hauptworker)
		"MCP_DAILY_LIMIT": "40",
		// Schutz vor Bursts (OpenRouter-Free erlaubt nur wenige Anfragen pro Minute)
		"MCP_PER_MINUTE_LIMIT": "200",
		// Rolle, die für automatische Delegation und Zusammenfassungen genutzt wird
		"COORDINATOR_ROLE": "KI-Koordination",
		// v3: Rolle für gezielte Nachprüfung; KI-Aufrufe, die für Nachprüfungen frei bleiben müssen
		"VERIFY_ROLE": "Kritische Prüfung",
		"QUALITY_RESERVE": "4",
		// v3: identische Anfragen innerhalb dieser Zeit kommen aus dem Cache (0 KI-Aufrufe)
		"CACHE_TTL_MINUTES": "360",
		// v3: nur Repositories dieser GitHub-Besitzer dürfen zur Code-Prüfung geladen werden
		"ALLOWED_REVIEW_OWNERS": "yannikzehnderyz-coder",
		// Test-Attrappen statt GitHub und Test-"Secrets" (Dummywerte)
		"GITHUB_WEB_BASE": "http://127.0.0.1:8790",
		"GITHUB_API_BASE": "http://127.0.0.1:8790",
		"GITHUB_CLIENT_ID": "test-client-id",
		"GITHUB_CLIENT_SECRET": "test-client-secret",
		"KI_TEAM_PASSWORD": "test-workspace-pw"
	},

	"dev": { "port": 8788, "ip": "127.0.0.1" }
}
